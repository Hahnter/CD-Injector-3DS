+//----------------------------------------------------------------------
+// Forwarder auto-boot.
+//
+// If the running title carries "romfs:/boot.txt" whose first line is the
+// absolute SD path of a ROM / CD image, load that game directly and skip
+// the file-selection menu. Returns true if the game was loaded.
+//
+// boot.txt example (single line):
+//   sdmc:/roms/pce/Rondo/Rondo.cue
+//----------------------------------------------------------------------
+static char forwarderRomName[_MAX_PATH];
+
+static void forwarderShowError(const char *title, const char *line1, const char *path)
+{
+    static char text[_MAX_PATH + 256];
+    snprintf(text, sizeof(text), "%s\n%s", line1, path);
+    menu3dsShowDialog(title, text, Themes[settings3DS.Theme].dialogColorWarn, optionsForOk);
+    menu3dsHideDialog();
+}
+
+bool tryAutoBootFromRomfs()
+{
+    FILE *fp = fopen("romfs:/boot.txt", "r");
+    if (!fp)
+        return false;
+
+    char line[_MAX_PATH];
+    char *got = fgets(line, sizeof(line), fp);
+    fclose(fp);
+    if (!got)
+        return false;
+
+    // Trim trailing CR/LF/whitespace.
+    int n = strlen(line);
+    while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r' || line[n - 1] == ' ' || line[n - 1] == '\t'))
+        line[--n] = 0;
+    if (n == 0)
+        return false;
+
+    forwarderMode = true;
+
+    // The menu isn't up yet, but the loading dialog draws over it.
+    menu3dsClearMenuTabs();
+    menu3dsAddTab(getText("选项"), emulatorNewMenu);
+    menu3dsSetCurrentMenuTab(0);
+    menu3dsSetTransferGameScreen(false);
+
+    FILE *game = fopen(line, "rb");
+    if (!game)
+    {
+        forwarderShowError("Game not found", "Check the game is on your SD card at:", line);
+        forwarderMode = false;
+        return false;
+    }
+    fclose(game);
+
+    // Split into directory (with trailing slash) + bare filename.
+    char *slash = strrchr(line, '/');
+    if (!slash)
+    {
+        forwarderMode = false;
+        return false;
+    }
+
+    strncpy(forwarderRomName, slash + 1, _MAX_PATH - 1);
+    forwarderRomName[_MAX_PATH - 1] = 0;
+    slash[1] = 0;
+
+    strncpy(forwarderBrowserDir, file3dsGetCurrentDir(), _MAX_PATH - 1);
+    strncpy(forwarderBrowserRom, romFileNameLastSelected, _MAX_PATH - 1);
+
+    file3dsSetCurrentDir(line);
+    romFileName = forwarderRomName;
+    strncpy(romFileNameLastSelected, forwarderRomName, _MAX_PATH - 1);
+
+    // Game embedded in the CIA: keep saves on the SD card, in a folder
+    // named after the game file (e.g. sdmc:/emus3ds/saves/Sonic CD/).
+    if (strncmp(line, "romfs:/", 7) == 0)
+    {
+        char stem[_MAX_PATH];
+        strncpy(stem, forwarderRomName, _MAX_PATH - 1);
+        stem[_MAX_PATH - 1] = 0;
+        char *dot = strrchr(stem, '.');
+        if (dot)
+            *dot = 0;
+
+        mkdir("sdmc:/emus3ds", 0777);
+        mkdir("sdmc:/emus3ds/saves", 0777);
+        snprintf(forwarderSaveDir, _MAX_PATH - 1, "sdmc:/emus3ds/saves/%s", stem);
+        mkdir(forwarderSaveDir, 0777);
+        strcat(forwarderSaveDir, "/");
+    }
+
+    // emulatorLoadRom() reads (currentDir + romFileName), loads the game,
+    // and sets emulatorState = EMUSTATE_EMULATE on success.
+    if (!emulatorLoadRom())
+    {
+        char fullPath[_MAX_PATH];
+        snprintf(fullPath, sizeof(fullPath), "%s%s", file3dsGetCurrentDir(), forwarderRomName);
+        forwarderShowError("Could not load game", "Is the BIOS / system card installed?", fullPath);
+        forwarderMode = false;
+        forwarderSaveDir[0] = 0;
+        return false;
+    }
+
+    menu3dsHideMenu();
+    consoleInit(screenSettings.SecondScreen, NULL);
+    consoleClear();
+    return true;
+}
