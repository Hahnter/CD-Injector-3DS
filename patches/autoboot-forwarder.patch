+//----------------------------------------------------------------------
+// Sets the current directory to an absolute path.
+// ROM loading builds the full path as (currentDir + fileName), so the
+// directory must end with a '/'.
+//----------------------------------------------------------------------
+void file3dsSetCurrentDir(const char *dir)
+{
+    strncpy(currentDir, dir, _MAX_PATH - 1);
+    currentDir[_MAX_PATH - 1] = 0;
+
+    int len = strlen(currentDir);
+    if (len > 0 && len < _MAX_PATH - 1 && currentDir[len - 1] != '/')
+    {
+        currentDir[len] = '/';
+        currentDir[len + 1] = 0;
+    }
+}
+
